{
  "name": "frontend",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--no-warnings node ./node_modules/vitest/vitest.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test e2e/journeys/recovery-live-smoke.spec.ts",
    "test:e2e:ci": "playwright test --config=playwright.ci.config.ts",
    "test:unit": "NODE_OPTIONS=--no-warnings node ./node_modules/vitest/vitest.mjs run",
    "test:setup": "NODE_OPTIONS=--no-warnings node ./node_modules/vitest/vitest.mjs run --config vitest.setup.config.ts",
    "test:coverage": "NODE_OPTIONS=--no-warnings node ./node_modules/vitest/vitest.mjs run --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@signalform/shared": "workspace:*",
    "@vueuse/core": "^14.4.0",
    "pinia": "^4.0.3",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-vue": "~10.11.1",
    "happy-dom": "^20.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.88.0",
    "postcss": "^8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
