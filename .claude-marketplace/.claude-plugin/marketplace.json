{
  "name": "signalform-plugins",
  "description": "LSP plugins for Signalform",
  "owner": { "name": "David" },
  "plugins": [
    {
      "name": "vue-lsp",
      "description": "Vue 3 LSP (v2 server)",
      "version": "1.0.0",
      "author": { "name": "David", "email": "d@example.com" },
      "source": "./.claude-plugin/plugins/vue-lsp",
      "strict": false,
      "lspServers": {
        "vue": {
          "command": "npx",
          "args": ["vue-language-server", "--stdio"],
          "extensionToLanguage": {
            ".vue": "vue"
          },
          "initializationOptions": {
            "typescript": {
              "tsdk": "node_modules/typescript/lib"
            }
          }
        }
      }
    }
  ]
}
