{
  "name": "signalform",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Signalform - Music Player Monorepo",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start:production": "node scripts/start-production-stack.mjs",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint -- --fix",
    "type-check": "pnpm -r run type-check",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check",
    "knip": "knip",
    "depcruise:shared": "cd packages/shared && ../../node_modules/.bin/depcruise src --ts-config tsconfig.json --config ../../.dependency-cruiser.cjs",
    "depcruise:backend": "cd packages/backend && ../../node_modules/.bin/depcruise src --ts-config tsconfig.json --config ../../.dependency-cruiser.cjs",
    "depcruise:frontend": "cd packages/frontend && ../../node_modules/.bin/depcruise src --ts-config tsconfig.app.json --config ../../.dependency-cruiser.cjs",
    "depcruise": "pnpm run depcruise:shared && pnpm run depcruise:backend && pnpm run depcruise:frontend",
    "madge:graph": "madge --image .review-artifacts/dependency-graph.svg packages/backend/src packages/frontend/src packages/shared/src",
    "check:types": "pnpm -r run type-check",
    "check:dead": "knip --reporter json",
    "check:arch": "pnpm run depcruise",
    "check:any": "type-coverage --project packages/shared/tsconfig.json --at-least 100 && type-coverage --project packages/backend/tsconfig.json --at-least 99.5 && type-coverage --project packages/frontend/tsconfig.app.json --at-least 97.54",
    "check:dupes": "jscpd",
    "check:hover-focus-opacity": "node scripts/check-hover-focus-opacity.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:comments": "node scripts/check-comments.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "review:collect": "node scripts/review-collect.mjs",
    "test:e2e:ci": "pnpm --filter frontend run build && pnpm --filter frontend run test:e2e:ci",
    "precommit": "pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run test:scripts && pnpm run type-check && pnpm run knip && pnpm run depcruise && pnpm run check:dupes && pnpm run check:hover-focus-opacity && pnpm run check:i18n && pnpm run check:comments",
    "quality-gates": "pnpm run precommit",
    "version:bump": "node scripts/bump-version.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/**/src/**/*.{ts,tsx,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "packages/**/*.{js,cjs,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vue/language-server": "^3.3.10",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.15",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "madge": "^8.0.0",
    "prettier": "3.9.6",
    "type-coverage": "^2.30.1",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.3.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  }
}
