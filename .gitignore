# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# Raw output from `pnpm run review:collect`
.review-artifacts/

# Raw output from `pnpm run check:dupes` (jscpd)
report/

# Test output
coverage/
packages/frontend/test-results/
packages/frontend/playwright-report/

# Environment variables (may contain secrets)
.env
.env.local
.env.*
.env-*

# Runtime config (contains secrets — LMS host, player ID, API keys)
packages/backend/config.json
signalform-config/config.json

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.bak
.cache/
.tmp/

# Working notes: plans, roadmaps, audit reports. Deliberately untracked —
# dated snapshots in the repo rot into misinformation. See docs/README.md.
.scratch/

# Claude Code agent worktrees
.claude/worktrees/
.claude/.reviewer-ran
.playwright-mcp/

# Third-party agent skills, installed per machine (caveman & Co.).
# Projekteigene Skills — .claude/skills/new-tidal-feature, .agents/skills/fcis —
# sind bewusst getrackt. Fremde Skills gehören nicht als Vendor-Kopie ins Repo:
# sie hängen an keinem Update-Pfad und sind eine reine Stilentscheidung.
.agents/skills/caveman*/
.agents/skills/cavecrew/
.claude/skills/caveman*
.claude/skills/cavecrew
skills-lock.json

# OS
Thumbs.db
signalform-config/
